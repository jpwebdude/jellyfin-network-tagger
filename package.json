{
  "name": "jellyfin-network-tagger",
  "version": "1.0.0",
  "description": "Scans your Jellyfin library, looks up streaming providers via TMDB, and writes normalized network tags back to Jellyfin.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit",
    "start": "node server.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
